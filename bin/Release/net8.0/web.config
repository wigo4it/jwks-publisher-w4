<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <!--
        Clearing hiddenSegments allows the dot-prefixed ".well-known" path to be served.
        allowDoubleEscaping is intentionally left at its (secure) default of false:
        the JWKS route contains no encoded characters, so enabling it would only widen
        the attack surface for double-encoded path-traversal/filter-bypass attempts.
      -->
      <requestFiltering>
        <hiddenSegments>
          <clear />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
